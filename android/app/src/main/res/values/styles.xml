<?xml version="1.0" encoding="utf-8"?>
<!-- MyKit is dark-only, so light and dark system modes share these themes. -->
<resources>
    <!-- Shown while the process starts, until Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window color behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/app_background</item>
    </style>
    <!-- Autofill unlock screen: transparent, so only the fingerprint prompt and
         the list of logins show over the app being filled. -->
    <style name="AutofillTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
